# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=your-openai-key
# Optional. App helpers and `npm run smoke:openai` default to gpt-4o.
OPENAI_MODEL=gpt-4o

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Required for checkout to work. Create these in the Stripe dashboard.
STRIPE_PRO_PRICE_ID=price_xxx_pro_monthly
STRIPE_POWER_PRICE_ID=price_xxx_power_monthly

# App
# Used for Stripe success/cancel URLs, OAuth callbacks, MCP server URL,
# and ChatGPT Action OpenAPI "servers" field. Must be the public origin,
# e.g. https://nexdo.ai (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Smoke-only values
# These are not required in the deployed app environment. Use them locally
# when running smoke commands against a real deployment.
# NEXDO_API_KEY=nxd_full_access_key
# NEXDO_READONLY_API_KEY=nxd_readonly_key
# Required only when `npm run smoke:routes` or `npm run smoke:launch` targets
# a Vercel preview protected by Deployment Protection.
# VERCEL_AUTOMATION_BYPASS_SECRET=your-vercel-bypass-secret
