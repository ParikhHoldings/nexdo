# Production or protected-preview smoke environment.
# Copy this file to `.env.production.local` and replace every placeholder with
# real values before running `npm run smoke:launch -- --env=.env.production.local`.
# Do not commit the copied `.env.production.local` file.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=your-openai-key
# Optional. App helpers and `npm run smoke:openai` default to gpt-4o.
OPENAI_MODEL=gpt-4o

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRO_PRICE_ID=price_xxx_pro_monthly
STRIPE_POWER_PRICE_ID=price_xxx_power_monthly

# App
# Use the preview or production public origin with no trailing slash.
NEXT_PUBLIC_APP_URL=https://your-preview.example

# Protected Vercel preview smoke support
# Required only when the target preview uses Vercel Deployment Protection.
# VERCEL_AUTOMATION_BYPASS_SECRET=your-vercel-bypass-secret

# Smoke-only MCP keys
# These are not deployed app runtime variables. Use shell exports for ad hoc
# MCP smoke checks when you are not using `npm run smoke:mcp -- --provision`.
# NEXDO_API_KEY=nxd_full_access_key
# NEXDO_READONLY_API_KEY=nxd_readonly_key
